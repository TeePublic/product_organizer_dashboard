{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "functions": {
    "api/refresh-cvr.js": { "includeFiles": "data/**" },
    "api/roadmap-refresh.js": { "includeFiles": "data/**" },
    "api/ab-refresh.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/roadmap-refresh", "schedule": "40 12,20 * * *" }
  ]
}